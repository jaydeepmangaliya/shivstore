# ============================================================
# Shiv-Store Environment Variables — EXAMPLE FILE
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to Git.
# ============================================================

# ── MySQL Database ───────────────────────────────────────────
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# ── JWT Secret ───────────────────────────────────────────────
# Must be at least 32 characters (256 bits). Use a random string.
# Generate one with: openssl rand -base64 64
JWT_SECRET=replace_this_with_a_long_random_secret_string_at_least_32_chars
