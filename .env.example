# ============================================================
# Shiv-Store Production Environment Variables
# ============================================================
# Copy this file to .env on your AWS EC2 instance.
# NEVER commit the real .env file to Git!
# ============================================================

# ── MongoDB Atlas Connection ─────────────────────────────────
MONGODB_URI=mongodb+srv://brandstore111111_db_user:1pLQbJVtQXEY070x@cluster0.b146y9k.mongodb.net/shiv_store_db?retryWrites=true&w=majority

# ── JWT Secret Key ───────────────────────────────────────────
# Must be at least 32 characters (256 bits).
# Generate one with: openssl rand -base64 48
JWT_SECRET=ShivStoreSecretKeyForJWTAuthenticationMustBeAtLeast256BitsLong2026

# ── Gmail SMTP Configuration (Password Reset Emails) ─────────
GMAIL_USERNAME=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
