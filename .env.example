# ============================================================
# Shiv-Store Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to Git!
# ============================================================

# ── MongoDB Atlas Connection ─────────────────────────────────
MONGODB_URI=mongodb+srv://YOUR_DB_USERNAME:YOUR_DB_PASSWORD@YOUR_CLUSTER.mongodb.net/shiv_store_db?retryWrites=true&w=majority

# ── JWT Secret Key ───────────────────────────────────────────
# Generate one with: openssl rand -base64 48
JWT_SECRET=YOUR_SECRET_JWT_KEY_AT_LEAST_32_CHARACTERS_LONG

# ── Gmail SMTP Configuration (Password Reset Emails) ─────────
GMAIL_USERNAME=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# ── AWS S3 Database Backup Configuration ────────────────────
AWS_S3_ENABLED=true
AWS_S3_BUCKET_NAME=your-s3-bucket-name
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BACKUP_FOLDER=backups
BACKUP_CRON_EXPRESSION=0 0 0 * * ?

